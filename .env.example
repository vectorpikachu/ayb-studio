# ===== Ayb environment =====

# Public URL used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Directory that stores the SQLite database (ayb.sqlite).
AYB_DATA_DIR=.data

# Marks the session cookie as Secure. "auto" (default) follows the request
# protocol, so plain-HTTP access (e.g. a bare IP during ICP filing) still works.
# Set to "true"/"always" once the site is served over HTTPS.
AYB_COOKIE_SECURE=auto

# The demo account is enabled automatically outside production.
# Set to true to enable it in production, or false to disable it everywhere.
# AYB_ENABLE_DEMO=false

# Optional: the account with this email becomes an admin after registration.
# If omitted, the first registered account becomes the admin.
# AYB_ADMIN_EMAIL=you@example.com

# IANA timezone used for the learning streak calendar.
# If omitted, the server's local timezone is used.
# AYB_TIMEZONE=Asia/Shanghai

# Optional: set in production, not needed for local development.
# NODE_ENV=production
