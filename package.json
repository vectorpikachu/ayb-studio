{
  "name": "ayb-armenian",
  "version": "0.1.0",
  "private": true,
  "description": "Ayb — a quiet studio for learning Armenian.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "qa": "node tests/e2e.mjs",
    "desktop": "electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --dir",
    "desktop:win": "npm run build && npm run desktop:prepare && electron-builder --win nsis --x64",
    "desktop:mac": "npm run build && npm run desktop:prepare && electron-builder --mac dmg"
  },
  "dependencies": {
    "lucide-react": "^0.548.0",
    "motion": "^12.23.24",
    "next": "^15.5.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "npm@11.19.0"
}
